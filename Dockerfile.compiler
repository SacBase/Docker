ARG VARIANT=cpu

FROM ubuntu:26.04 AS cpu
ENV SAC_TARGETS="seq;seq_checks;mt_pth"
ENV SAC_CUDA=OFF

FROM nvidia/cuda:13.3.1-devel-ubuntu26.04 AS cuda
ENV SAC_TARGETS="seq;seq_checks;mt_pth;cuda"
ENV SAC_CUDA=ON

FROM ${VARIANT}

LABEL maintainer="SaC Development Team <info@sac-home.org>"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
  linux-tools-generic \
  build-essential \
  ca-certificates \
  ninja-build \
  cmake \
  curl \
  git \
  numactl \
  python3 \
  xsltproc \
  openmpi-bin \
  libopenmpi-dev \
  libhwloc-dev \
  uuid-runtime \
  uuid-dev \
  bison \
  flex \
  m4
# Delete local APT package index files
RUN rm -rf /var/lib/apt/lists/*

# Build and install the SaC compiler
RUN git clone --recursive --single-branch https://gitlab.sac-home.org/sac-group/sac2c.git sac2c \
 && cd sac2c \
 && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RELEASE \
 && cmake --build build -j4 \
 && ln -s $PWD/build/sac2c_p /usr/local/bin/sac2c \
 && sac2c -V

# Ensure linker cache is valid
RUN ldconfig

# Build and install the standard library
RUN git clone --recursive --single-branch https://github.com/SacBase/Stdlib.git sac-stdlib \
 && cd sac-stdlib \
 && cmake -S . -B build -G Ninja -DTARGETS="${SAC_TARGETS}" -DBUILD_EXT=ON -DLINKSETSIZE=200 \
 && cmake --build build -j2

# Build and install energy measuring library
RUN git clone --recursive --single-branch https://github.com/SacBase/Energy.git sac-energy \
 && cd sac-energy \
 && cmake -S . -B build -G Ninja -DTARGETS="${SAC_TARGETS}" \
 && cmake --build build -j2

# Copy .sac2crc to home directory
RUN cp -r /root/.sac2crc /home/.sac2crc

WORKDIR /home
